# Copy to .env.local and replace the hostnames before `npm run build`.
# NEXT_PUBLIC_* values are inlined into the bundle at build time.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ADMIN_API_URL=
NEXT_PUBLIC_WS_URL=wss://hydrocast-admin.example.org/ws/admin/telemetry
NEXT_PUBLIC_ADMIN_WS_URL=wss://hydrocast-admin.example.org/ws/admin/telemetry
PORT=3001
BACKEND_ORIGIN=http://127.0.0.1:8000
ADMIN_BACKEND_ORIGIN=http://127.0.0.1:8001
PUBLIC_PORTAL_URL=https://hydrocast.example.org
