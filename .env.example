# =============================================================================
# HydroCast Panchganga — Windows Server Production Environment
# Target: Windows Server Standard @ Shivaji University Kolhapur (SUK)
# Catchment: Panchganga River Basin (1,837.21 km²), Kolhapur, Maharashtra
# =============================================================================
# Copy this file to .env and fill in your production values.
# NEVER commit .env to Git — state and secrets stay on the server only.
# =============================================================================

# ── Database (PostgreSQL 16 + PostGIS on Windows Server) ─────────────────────
DATABASE_URL=postgresql://hms_app:hms_secret_2026@127.0.0.1:5432/rainfall_runoff
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rainfall_runoff
DB_USER=hms_app
DB_PASSWORD=hms_secret_2026

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=change-this-public-api-key-in-production
REQUIRE_API_KEY=true
PUBLIC_CACHE_MAX_AGE=300

# ── JWT / Admin Authentication ────────────────────────────────────────────────
JWT_SECRET=change-this-jwt-secret-min-32-chars-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password-in-production
RATE_LIMIT_LOGIN=5/minute

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC=100/minute
MAX_REQUEST_BYTES=1000000
MAX_WS_CONNECTIONS=200

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_CORS_ORIGINS=http://localhost:3001

# ── ThingSpeak IoT (Ultrasonic Radar @ Shivaji Bridge) ────────────────────────
THINGSPEAK_CHANNEL_ID=3424513
THINGSPEAK_READ_API_KEY=change-this-thingspeak-read-key
THINGSPEAK_WRITE_API_KEY=change-this-thingspeak-write-key
THINGSPEAK_URL=https://api.thingspeak.com
THINGSPEAK_FIELDS=field1,field2,field3
THINGSPEAK_INTERVAL_SECONDS=300

# ── Weather (Open-Meteo / ECMWF IFS 90h) ──────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/era5
WEATHER_LEAD_HOURS=90
WEATHER_RETRY_MAX=3
WEATHER_RETRY_BACKOFF=2

# ── HEC-HMS 4.13 (Windows headless) ───────────────────────────────────────────
HEC_HMS_PATH=C:\Program Files\HEC\HEC-HMS-4.13\HEC-HMS.exe
HMS_FORCE_EMULATOR=0
MONSOON_BASEFLOW=91.1

# ── File Paths (Windows Server E:\ drive) ─────────────────────────────────────
PROJECT_ROOT=E:\Hydrocast Windows Server
DATA_DIR=E:\Hydrocast Windows Server\data
DSS_DIR=E:\Hydrocast Windows Server\dss
HMS_DIR=E:\Hydrocast Windows Server\dss\HMS_Automation_RJKT
LOGS_DIR=E:\Hydrocast Windows Server\data\logs
STAGING_DIR=E:\Hydrocast Windows Server\data\staging
TELEMETRY_DIR=E:\Hydrocast Windows Server\data\telemetry
RUNS_DIR=E:\Hydrocast Windows Server\data\runs

# ── Visitor Counter (IP hashing) ──────────────────────────────────────────────
VISIT_HASH_SALT=change-this-visit-hash-salt-in-production

# ── Windows Services (NSSM) ───────────────────────────────────────────────────
NSSM_PATH=C:\Program Files\nssm\nssm.exe
SERVICE_NAME_BACKEND=HydroCast-Backend
SERVICE_NAME_SCHEDULER=HydroCast-Scheduler
SERVICE_NAME_WATCHDOG=HydroCast-Watchdog
SERVICE_NAME_PUBLIC=HydroCast-Public-Web
SERVICE_NAME_CONSOLE=HydroCast-Operator-Console

# =============================================================================
# END OF ENVIRONMENT CONFIGURATION
# =============================================================================
