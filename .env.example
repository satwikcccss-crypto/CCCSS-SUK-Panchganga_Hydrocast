# ==============================================================
# HydroCast Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ==============================================================

# ---- Database -------------------------------------------------
# Windows Server local: postgresql://hms_app:PASSWORD@localhost:5432/rainfall_runoff
# Supabase:             postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://hms_app:CHANGE_ME@localhost:5432/rainfall_runoff

# ---- Catchment Bounding Box (matches GitHub Actions workflow) ---
BBOX_N=17.20
BBOX_S=16.20
BBOX_E=74.50
BBOX_W=73.70

# ---- Open-Meteo (no key needed, leave blank) -------------------
# For true ECMWF MARS 9km access:
USE_MARS=false
ECMWF_API_KEY=
ECMWF_API_EMAIL=

# ---- HEC-HMS project (offline Windows validation only) --------
HMS_HOME=C:\Program Files\HEC\HEC-HMS-4.13
HMS_PROJECT_DIR=data\hms\HMS_Automation_RJKT
HMS_PROJECT_NAME=HMS_Automation_RJKT.hms
HMS_RUN_NAME=Run 1
HMS_SINK_NODE=Sink-1
# DSS boundary file the Gage Manager reads from:
DSS_PATH=data/hms/HMS_Automation_RJKT/HMS_Automation_RJKT.dss

# ---- Stage conversion: bridge travel times (hours from outlet) --
TT_SHIVAJI=1.5
TT_RAJARAM=3.0

# ---- IoT Gauge API ---------------------------------------------
IOT_API_BASE=https://your-iot-platform/api/v1/gauges
IOT_API_KEY=

# ---- API backend, rate limiting & security ---------------------
API_KEY=Hydrocast_PCH
INTERNAL_KEY=CHANGE_ME_INTERNAL_SECRET
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app
RATE_LIMIT_PUBLIC=100/minute
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production

# ---- Notifications & emergency alerting (DDMA & CWC) -----------
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100xxxxxxxxx
# Optional comma-separated DDMA control room channels:
DDMA_TELEGRAM_CHATS=-100xxxxxxxxx,-100yyyyyyyyy
# Optional comma-separated webhook endpoints for district disaster management:
DISASTER_MANAGEMENT_WEBHOOKS=https://alert-dispatch.district.gov.in/api/v1/cwc-hook

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hydrocast@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAILS=engineer@cwc.gov.in,duty@district.gov.in

# ---- Cold storage & archival -----------------------------------
ARCHIVE_RETENTION_DAYS=90
ARCHIVE_DIR=data/archives

# ---- Frontend (Next.js) ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# ---- File storage ----------------------------------------------
RAW_DIR=data/raw
MONSOON_BASEFLOW=91.1

# ---------------------------------------------------------------
# GitHub Actions secrets (set in repo Settings > Secrets):
#   DATABASE_URL / API_KEY / INTERNAL_KEY / TELEGRAM_BOT_TOKEN /
#   TELEGRAM_CHAT_ID / THINGSPEAK_CHANNEL_ID / THINGSPEAK_API_KEY /
#   SMTP_USER / SMTP_PASS / ALERT_EMAILS
# ---------------------------------------------------------------