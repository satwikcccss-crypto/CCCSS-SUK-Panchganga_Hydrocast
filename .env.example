# ── HydroCast Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in real values
# Never commit .env to git

# ── Database ─────────────────────────────────────────────────────────────────
# Windows Server local: postgresql://hms_app:PASSWORD@localhost:5432/rainfall_runoff
# Supabase:             postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://hms_app:CHANGE_ME@localhost:5432/rainfall_runoff

# ── Catchment Bounding Box ───────────────────────────────────────────────────
BBOX_N=22.0
BBOX_S=17.0
BBOX_E=78.5
BBOX_W=73.0

# ── Open-Meteo (no key needed — leave blank) ──────────────────────────────────
# For true ECMWF MARS 9km access:
USE_MARS=false
ECMWF_API_KEY=
ECMWF_API_EMAIL=

# ── HEC-HMS ───────────────────────────────────────────────────────────────────
HMS_HOME=C:\HEC\HEC-HMS-4.11
HMS_PROJECT_DIR=data\hms\project
HMS_PROJECT_NAME=Panchganga.hms
HMS_RUN_NAME=ForecastRun
HMS_SINK_NODE=J_Outlet
DSS_PATH=data/hms/rainfall_input.dss

# ── Stage conversion: bridge travel times (hours from J_Outlet) ───────────────
TT_SHIVAJI=1.5
TT_RAJARAM=3.0

# ── IoT Gauge API ─────────────────────────────────────────────────────────────
IOT_API_BASE=https://your-iot-platform/api/v1/gauges
IOT_API_KEY=

# ── API backend ───────────────────────────────────────────────────────────────
API_KEY=CHANGE_ME_STRONG_KEY
INTERNAL_KEY=CHANGE_ME_INTERNAL_SECRET
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100xxxxxxxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hydrocast@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAILS=engineer@cwc.gov.in,duty@district.gov.in

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# ── File storage ──────────────────────────────────────────────────────────────
RAW_DIR=data/raw

# ── GitHub Actions secrets (set in repo → Settings → Secrets) ────────────────
# DATABASE_URL      → same as above
# API_KEY           → same as above
# INTERNAL_KEY      → same as above
# ECMWF_API_KEY     → if USE_MARS=true
# ECMWF_API_EMAIL   → if USE_MARS=true
# HMS_HOME          → e.g. C:\HEC\HEC-HMS-4.11
# HMS_PROJECT_DIR   → absolute path on Windows runner
# TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID
# SMTP_USER
# SMTP_PASS
# ALERT_EMAILS
