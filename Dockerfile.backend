# =============================================================================
# HydroCast Panchganga — Production Backend Container
# Target: Windows Server Standard @ Shivaji University Kolhapur (SUK)
#
# Build:  docker build -f Dockerfile.backend -t hydrocast-backend:2.1.0 .
# Run:    docker run -p 8000:8000 --env-file .env hydrocast-backend:2.1.0
#
# NOTE: PostgreSQL is NOT included in this image. The backend degrades
# gracefully to disk-backed staging when PostgreSQL is unavailable.
# For full persistence, use docker-compose (which links the PostGIS service).
# Secrets must come from the environment / .env at runtime — never bake
# .env into the image.
# =============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_URL=postgresql://hms_app:hms_secret_2026@db:5432/rainfall_runoff \
    API_KEY=change-me-in-production \
    JWT_SECRET=change-me-in-production \
    ADMIN_PASSWORD=change-me-in-production \
    REQUIRE_API_KEY=false

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

# Copy application code
COPY backend/ ./backend/
COPY data/ ./data/
COPY database/ ./database/
COPY windows/ ./windows/

# Create data directories
RUN mkdir -p /app/data/logs /app/data/staging/pending_commits /app/data/telemetry /app/data/runs

# Expose ports
EXPOSE 8000

# Liveness probe: process responsiveness only, no database dependency.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthz/live || exit 1

# Run the backend
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
